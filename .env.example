# Copie para .env na raiz: o docker compose lê este arquivo.
#   cp .env.example .env

# Banco (container do compose). Se mudar estes valores, defina também DATABASE_URL (veja abaixo),
# porque o padrão dela usa aurora/aurora/aurora.
POSTGRES_USER=aurora
POSTGRES_PASSWORD=aurora
POSTGRES_DB=aurora

# --- Banco e Redis externos (opcional) ---
# Por padrão a API usa os containers postgres e redis do compose. Para usar outros, descomente
# e suba sem eles: docker compose up --build --no-deps api web
#
# Postgres na própria máquina (de dentro do container, o host é host.docker.internal; o Postgres
# precisa escutar fora de localhost: listen_addresses e pg_hba.conf):
# DATABASE_URL=postgres://aurora:senha@host.docker.internal:5432/aurora?sslmode=disable
#
# Supabase (Project Settings > Database > Connection string). Use a conexão direta ou o
# "session pooler" e sslmode=require:
# DATABASE_URL=postgres://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require
# Se usar o "transaction pooler" (porta 6543), acrescente default_query_exec_mode=simple_protocol
# na DATABASE_URL e informe a conexão direta/session para as migrations:
# MIGRATE_DATABASE_URL=postgres://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require
#
# Redis (rediss:// para TLS, como no Upstash):
# REDIS_URL=redis://host.docker.internal:6379/0

# Segredo do token de acesso: OBRIGATÓRIO, 32+ caracteres aleatórios. Não há valor padrão e a API
# recusa valores de exemplo ou fracos. Gere um (ou use `make env`, que já faz isso):
#   openssl rand -hex 32
JWT_SECRET=

# true em produção (cookie de refresh só por HTTPS)
COOKIE_SECURE=false

# Origens liberadas no CORS, separadas por vírgula
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# Quem se cadastra com este e-mail vira admin (opcional)
ADMIN_EMAIL=
